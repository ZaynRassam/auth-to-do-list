<% if (Array.isArray(dbUserTasks) && dbUserTasks.length > 0) {%>
    <% dbUserTasks.forEach(task => { %>
        <% if (task.completed == completedBool) {%>
            <div class="task-container">
                <div class="task-content">
                    <div class="priority">
                        <% if (task.priority == "low") {%>
                            <h1 class="priority-low">!</h1>
                        <% } else if (task.priority == "medium"){%>
                            <h1 class="priority-medium">!!</h1>
                        <% } else {%>
                            <h1 class="priority-high">!!!</h1>
                        <%}%>
                    </div>
                    <div class="task">
                        <h3><%= task.task_title%></h3>
                        <p><%= task.task_description%></p>
                        <p><%= task.created_at.toLocaleTimeString('pt-PT').substr(0, 5)%> | <%= task.created_at.toLocaleDateString('pt-PT')%></p>
                    </div>
                </div>
                <div class="task-button">
                    <form action="/to-do-list/update-task-completion-status" method="post">
                        <input type="hidden" id="taskID" name="taskID" value=<%=task.task_id%>>
                        <input type="hidden" id="taskCompleteStatus" name="taskCompleteStatus" value=<%=task.completed%>>
                        <button type="submit" class="uncomplete-task button">
                            <% if (task.completed) { %>
                                Uncomplete
                            <% } else { %>
                                Complete
                            <% } %>
                        </button>
                    </form>
                    <form action="/to-do-list/delete-task" method="post">
                        <input type="hidden" id="taskDeleteID" name="taskDeleteID" value=<%=task.task_id%>>
                        <button type="submit">Delete</button>
                    </form>
                </div>
            </div>
        <% }%>
    <%}) %>
<%} else {%>
    <br>
    <p>Nothing to show!</p>
<% } %>